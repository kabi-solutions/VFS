# Vault Financial Services — public / client env
# Copy to `.env.local` for local Next.js. Do not commit real secrets.
# Project: VFS (ref fsatcxmmfvmspremmtmu) — see docs/supabase-project.md

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source: mock | supabase (defaults to supabase when URL+anon are set)
# NEXT_PUBLIC_DATA_SOURCE=supabase

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://fsatcxmmfvmspremmtmu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only (never expose to the browser / never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias also accepted:
# SUPABASE_SERVICE_KEY=

# Optional: portal demo role switcher (off unless explicitly true)
# NEXT_PUBLIC_ENABLE_DEMO_ROLE_SWITCHER=true
